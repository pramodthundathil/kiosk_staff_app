{
  "expo": {
    "name": "Excel Catalog",
    "slug": "excel-catalog",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050811"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.excelearting.staffapp",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.excelearting.staffapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#050811"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4a7a315d-2446-4671-a0f3-51e1d8eb7ca1"
      }
    }
  }
}
